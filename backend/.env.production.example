APP_NAME="Invoice SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://invoice.nexaibyte.com/backend
ASSET_URL=https://invoice.nexaibyte.com/backend
FRONTEND_URL=https://invoice.nexaibyte.com
LOG_CHANNEL=stack
LOG_STACK=single
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD="CHANGE_ME"
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
MAIL_MAILER=log
MAIL_FROM_ADDRESS=billing@nexaibyte.com
MAIL_FROM_NAME="Nexaibyte LTD"
WHATSAPP_ENABLED=false
INVOICE_REMINDER_DAYS_BEFORE_DUE=3

# Public branding images: local or cloudinary
MEDIA_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=invoice-saas
